# --- Media: images & videos never go to GitHub (served from storage/CDN) ---
export/media/
public/media
*.jpg
*.jpeg
*.png
*.webp
*.avif
*.gif
*.tif
*.tiff
*.heic
*.mp4
*.mov
*.webm
*.m4v
*.avi
*.mkv
# Small brand assets (logo, icons) are allowed here
!public/brand/**
!app/icon.png
!app/apple-icon.png

# --- Old-site export: raw database data stays local ---
export/raw/
export/*.sql
export/*.sql.gz
*.sql
*.sql.gz

# --- Dependencies ---
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Next.js / build output ---
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# --- Testing ---
coverage/
playwright-report/
test-results/

# --- Env & secrets ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Vercel ---
.vercel

# --- Logs & debug ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# --- Tooling ---
.playwright-mcp/
__pycache__/
*.pyc

# --- Editors & OS ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
